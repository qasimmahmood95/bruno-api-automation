meta {
  name: Cannot Create Booking with Invalid Name
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/booking
  body: json
  auth: none
}

body:json {
  {
      "firstname" : 1,
      "lastname" : 1,
      "totalprice" : 999,
      "depositpaid" : true,
      "bookingdates" : {
          "checkin" : "1924-01-01",
          "checkout" : "1925-01-01"
      },
      "additionalneeds" : "Halal Food"
  }
}

assert {
  res.status: eq 500
}

docs {
  Sends numbers where firstname/lastname strings are expected. Restful-Booker
  responds with 500 Internal Server Error instead of a 400 validation error -
  a known weakness of the API. The test pins the actual behaviour; in a real
  project this would also be raised as a bug against the service.
}
