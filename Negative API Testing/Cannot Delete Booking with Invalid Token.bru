meta {
  name: Cannot Delete Booking with Invalid Token
  type: http
  seq: 7
}

delete {
  url: {{baseUrl}}/booking/{{negativeBookingId}}
  body: none
  auth: none
}

headers {
  Cookie: token=invalid-token
}

script:pre-request {
  if (!bru.getVar("negativeBookingId")) {
    throw new Error("negativeBookingId is not set - run 'Setup - Create Fixture Booking' first (or run the folder as a whole)");
  }
}

assert {
  res.status: eq 403
}

docs {
  Attempts to delete the fixture booking (created by the setup request) with
  an invalid auth token. The API must refuse with 403 Forbidden.

  The pre-request guard fails fast if the fixture id was never captured -
  without it, the API's token check (which runs before the id is resolved)
  would return 403 even for a garbage URL and the test would pass vacuously.
}
