meta {
  name: Cannot Create Booking with Missing Date
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/booking
  body: json
  auth: none
}

body:json {
  {
      "firstname" : "Qasim",
      "lastname" : "Mahmood",
      "totalprice" : 111,
      "depositpaid" : true,
      "bookingdates" : {
          "checkin" : "2024-01-01"
      },
      "additionalneeds" : "Halal Food"
  }
}

assert {
  res.status: eq 500
}

docs {
  Omits the required bookingdates.checkout field. As with other validation
  failures, Restful-Booker surfaces this as 500 Internal Server Error rather
  than a 400 - the test pins the API's actual behaviour.
}
