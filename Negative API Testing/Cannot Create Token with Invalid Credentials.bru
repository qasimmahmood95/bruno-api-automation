meta {
  name: Cannot Create Token with Invalid Credentials
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth
  body: json
  auth: none
}

body:json {
  {
      "username" : "not-a-real-user",
      "password" : "wrong-password"
  }
}

assert {
  res.status: eq 200
  res.body.reason: eq "Bad credentials"
}

tests {
  test("does not issue a token", function() {
    expect(res.getBody()).to.not.have.property("token");
  });
}

docs {
  Attempts to authenticate with invalid credentials. Restful-Booker returns
  200 OK with a {"reason": "Bad credentials"} body instead of the
  conventional 401 Unauthorized - the test pins that actual behaviour and
  additionally asserts that no token is issued.
}
