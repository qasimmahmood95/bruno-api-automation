meta {
  name: Health Check
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/ping
  body: none
  auth: none
}

assert {
  res.status: eq 201
}

docs {
  Verifies the API is reachable before the rest of the suite runs.

  Note: Restful-Booker's /ping endpoint returns 201 Created rather than the
  conventional 200 OK. This is the documented behaviour of the API, so the
  test asserts 201 deliberately.
}
