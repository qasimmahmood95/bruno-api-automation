meta {
  name: Cannot Get Booking After Deleting
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/booking/{{bookingId}}
  body: none
  auth: none
}

assert {
  res.status: eq 404
}

docs {
  Closes the lifecycle: fetching the booking deleted in the previous step
  must return 404, proving the delete actually removed the resource.
}
