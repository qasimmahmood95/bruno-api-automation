meta {
  name: Create Token
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth
  body: json
  auth: none
}

body:json {
  {
      "username" : "{{authUsername}}",
      "password" : "{{authPassword}}"
  }
}

vars:post-response {
  token: res.body.token
}

assert {
  res.status: eq 200
}

tests {
  test("returns a non-empty auth token", function() {
    expect(res.getBody().token).to.be.a("string").that.is.not.empty;
  });
}

docs {
  Authenticates against /auth and stores the returned token in the token
  runtime variable, which the update and delete requests send as a cookie.

  Credentials come from the Restful-Booker environment. These are the
  public, documented credentials of the Restful-Booker demo API - in a real
  project they would be injected from a secret store, never committed.
}
