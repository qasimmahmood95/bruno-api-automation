meta {
  name: Delete Booking
  type: http
  seq: 10
}

delete {
  url: {{baseUrl}}/booking/{{bookingId}}
  body: none
  auth: none
}

headers {
  Cookie: token={{token}}
}

assert {
  res.status: eq 201
}

docs {
  Deletes the booking created at the start of the lifecycle.

  Note: Restful-Booker returns 201 Created for a successful DELETE rather
  than the conventional 200/204. The test asserts the API's actual,
  documented behaviour.
}
