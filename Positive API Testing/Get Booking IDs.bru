meta {
  name: Get Booking IDs
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/booking
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("returns a non-empty list of bookings", function() {
    const bookings = res.getBody();
    expect(bookings).to.be.an("array").that.is.not.empty;
  });

  test("every entry exposes a numeric bookingid", function() {
    const invalid = res.getBody().filter(function(entry) {
      return !Number.isInteger(entry.bookingid);
    });
    expect(invalid).to.be.empty;
  });
}

docs {
  Lists all booking ids currently held by the API. Restful-Booker seeds its
  database with sample bookings, so the list is expected to be non-empty.
}
