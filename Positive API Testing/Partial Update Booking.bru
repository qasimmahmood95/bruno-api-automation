meta {
  name: Partial Update Booking
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/booking/{{bookingId}}
  body: json
  auth: none
}

headers {
  Cookie: token={{token}}
}

body:json {
  {
      "totalprice" : 1000
  }
}

assert {
  res.status: eq 200
  res.body: isDefined
}

tests {
  test("updates only the patched field", function() {
    expect(res.getBody().totalprice).to.equal(1000);
  });

  test("preserves fields not included in the patch", function() {
    const booking = res.getBody();
    expect(booking.firstname).to.equal(bru.getVar("updatedFirstname"));
    expect(booking.lastname).to.equal(bru.getVar("updatedLastname"));
    expect(booking.additionalneeds).to.equal(bru.getVar("updatedAdditionalNeeds"));
  });
}

docs {
  Partially updates the booking via PATCH, changing only totalprice, and
  verifies that untouched fields keep the values set by the previous PUT -
  compared against runtime variables captured from the PUT response, so the
  expected values live in one place.
}
