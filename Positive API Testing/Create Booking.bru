meta {
  name: Create Booking
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/booking
  body: json
  auth: none
}

body:json {
  {
      "firstname" : "Qasim",
      "lastname" : "Mahmood",
      "totalprice" : 999,
      "depositpaid" : true,
      "bookingdates" : {
          "checkin" : "2024-01-01",
          "checkout" : "2025-01-01"
      },
      "additionalneeds" : "Halal Food"
  }
}

vars:post-response {
  bookingId: res.body.bookingid
}

assert {
  res.status: eq 200
}

tests {
  test("returns a numeric booking id", function() {
    expect(res.getBody().bookingid).to.be.a("number");
  });

  test("echoes back the submitted booking", function() {
    const booking = res.getBody().booking;
    expect(booking.firstname).to.equal("Qasim");
    expect(booking.lastname).to.equal("Mahmood");
    expect(booking.totalprice).to.equal(999);
    expect(booking.depositpaid).to.equal(true);
    expect(booking.bookingdates.checkin).to.equal("2024-01-01");
    expect(booking.bookingdates.checkout).to.equal("2025-01-01");
    expect(booking.additionalneeds).to.equal("Halal Food");
  });
}

docs {
  Creates the booking used by the rest of the positive lifecycle. The
  generated id is captured into the bookingId runtime variable and consumed
  by the subsequent get/update/delete requests.
}
