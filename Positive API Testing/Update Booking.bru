meta {
  name: Update Booking
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/booking/{{bookingId}}
  body: json
  auth: none
}

headers {
  Cookie: token={{token}}
}

body:json {
  {
      "firstname" : "Qasim",
      "lastname" : "Mahmood",
      "totalprice" : 999,
      "depositpaid" : true,
      "bookingdates" : {
          "checkin" : "2024-01-01",
          "checkout" : "2025-01-01"
      },
      "additionalneeds" : "Halal Food and Entertainment"
  }
}

vars:post-response {
  updatedFirstname: res.body.firstname
  updatedLastname: res.body.lastname
  updatedAdditionalNeeds: res.body.additionalneeds
}

assert {
  res.status: eq 200
  res.body: isDefined
}

tests {
  test("applies the full update", function() {
    const booking = res.getBody();
    expect(booking.additionalneeds).to.equal("Halal Food and Entertainment");
    expect(booking.firstname).to.equal("Qasim");
    expect(booking.totalprice).to.equal(999);
  });
}

docs {
  Replaces the booking created earlier via PUT, authenticated with the token
  cookie captured by Create Token. Verifies the updated fields are returned.

  The updated field values are also captured as runtime variables so the
  Partial Update request can verify preservation against what this request
  actually set, instead of duplicating the literals across files.
}
